# Maintainer: Nuvio Media <dev@nuvio.tv>
# Contributor: JJDizz1L
#
# Build from local source: run `makepkg -si` from this directory.
# The repo root is expected at ${startdir}/../.. (referred to as $REPO_ROOT).

pkgname=nuvio-linux
pkgver=0.1.0
pkgrel=1
pkgdesc="Nuvio desktop media player — Linux native mpv playback"
arch=('x86_64')
url="https://github.com/JJDizz1L/NuvioDesktop"
license=('custom:commercial')
depends=('mpv' 'glibc' 'gcc-libs' 'libstdc++' 'libx11' 'libxext' 'libxrender' 'libxi' 'libxtst')
makedepends=('jdk21-openjdk' 'gcc')
provides=("${pkgname}")
conflicts=("${pkgname}")
source=()
noextract=()
sha256sums=()

export GRADLE_OPTS="-Dorg.gradle.parallel=false"
export JAVA_HOME=/usr/lib/jvm/java-21-openjdk

build() {
  local REPO_ROOT="${startdir}/../.."
  cd "${REPO_ROOT}"
  echo "[nuvio-pkg] Building from ${REPO_ROOT}"
  ./gradlew :composeApp:createDistributable
}

package() {
  local REPO_ROOT="${startdir}/../.."
  local APP_DIR="${pkgdir}/opt/nuvio-linux"

  cd "${REPO_ROOT}"

  # Self-contained app bundle from jpackage
  install -d "${APP_DIR}"
  cp -r composeApp/build/compose/binaries/main/app/Nuvio/* "${APP_DIR}/"

  # Symlink launcher
  install -d "${pkgdir}/usr/bin"
  ln -s /opt/nuvio-linux/bin/Nuvio "${pkgdir}/usr/bin/nuvio-linux"

  # Desktop entry
  install -Dm644 "${startdir}/nuvio-linux.desktop" \
    "${pkgdir}/usr/share/applications/nuvio-linux.desktop"
}
