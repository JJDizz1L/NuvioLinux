# Maintainer: JJDizz1L
#
# Build from local source: run `makepkg -si` from this directory.
# Release builds (signed): `GPGKEY=6702DBAB3E41EDE1 makepkg -f --sign`.
# The public key lives in nuvio-linux-gpg-key.asc in this directory.
# The repo root is expected at ${startdir}/../.. (referred to as $REPO_ROOT).

pkgname=nuvio-linux
pkgver=0.1.17alpha
pkgrel=6
pkgdesc="Nuvio Linux desktop media player — Linux native mpv playback"
arch=('x86_64')
url="https://github.com/JJDizz1L/NuvioLinux"
license=('custom:commercial')
depends=('mpv' 'glibc' 'gcc-libs' 'libstdc++' 'libx11' 'libxext' 'libxrender' 'libxi' 'libxtst')
makedepends=('jdk21-openjdk' 'gcc')
install=nuvio-linux.install
provides=("${pkgname}")
conflicts=("${pkgname}")
source=()
noextract=()
sha256sums=()

export GRADLE_OPTS="-Dorg.gradle.parallel=false"
# Release signing key (Omarchy). makepkg signs with --sign when GPGKEY is set.
export GPGKEY="${GPGKEY:-6702DBAB3E41EDE1}"
# Build with a baseline x86-64 JDK (e.g. Temurin) so the bundled JRE is
# portable. Distro JDKs built with -march=native/-march=x86-64-v3/v4 (e.g.
# CachyOS) produce a runtime that only runs on those CPUs.
export JAVA_HOME="${JAVA_HOME:-/usr/lib/jvm/java-21-openjdk}"
echo "[nuvio-linux-pkg] Using JAVA_HOME=${JAVA_HOME}"

build() {
  local REPO_ROOT="${startdir}/../.."
  cd "${REPO_ROOT}"
  echo "[nuvio-linux-pkg] Building from ${REPO_ROOT}"
  ./gradlew :composeApp:createReleaseDistributable
}

package() {
  local REPO_ROOT="${startdir}/../.."
  local APP_DIR="${pkgdir}/opt/nuvio-linux"

  cd "${REPO_ROOT}"

  # Self-contained app bundle from jpackage (release variant, matching the
  # deb/rpm artifacts)
  install -d "${APP_DIR}"
  cp -r composeApp/build/compose/binaries/main-release/app/nuvio-linux/* "${APP_DIR}/"

  # Symlink launcher
  install -d "${pkgdir}/usr/bin"
  ln -s /opt/nuvio-linux/bin/nuvio-linux "${pkgdir}/usr/bin/nuvio-linux"

  # Desktop entry, icons and AppStream metadata
  install -Dm644 dist/desktop/nuvio-linux.desktop \
    "${pkgdir}/usr/share/applications/nuvio-linux.desktop"
  install -Dm644 dist/desktop/io.github.jjdizz1l.NuvioLinux.metainfo.xml \
    "${pkgdir}/usr/share/metainfo/io.github.jjdizz1l.NuvioLinux.metainfo.xml"
  for size in 16 32 48 64 128 256 512; do
    install -Dm644 "dist/desktop/icons/hicolor/${size}x${size}/apps/nuvio-linux.png" \
      "${pkgdir}/usr/share/icons/hicolor/${size}x${size}/apps/nuvio-linux.png"
  done
}
